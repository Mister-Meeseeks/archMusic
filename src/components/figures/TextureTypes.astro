---
// The four basic textures, drawn as pitch-over-time lines. One melody (the
// same contour in every panel) is the starting point: alone (monophony);
// with a simultaneous decorated version of itself (heterophony); on top of
// chords that move in its rhythm (homophony); and against other lines with
// their own contours and rhythms (polyphony).
import Figure from '../ui/Figure.astro';

const r = (v: number) => Math.round(v * 10) / 10;
// melody: [start, length, pitch] in arbitrary units (time 0–16, pitch 0–14)
const MEL: [number, number, number][] = [[0, 2, 6], [2, 2, 8], [4, 2, 9], [6, 2, 8], [8, 3, 11], [11, 1, 10], [12, 2, 8], [14, 2, 7]];
const DECOR: [number, number, number][] = [
  [0, 1, 6], [1, 1, 7], [2, 1, 8], [3, 1, 9], [4, 1.5, 9], [5.5, 0.5, 10], [6, 2, 8], [8, 1, 11], [9, 1, 12], [10, 1, 11], [11, 1, 10], [12, 1, 9], [13, 1, 8], [14, 2, 7],
];
const CHORDS: [number, number, number[]][] = [[0, 4, [1, 3, 5]], [4, 4, [2, 4, 6]], [8, 4, [3, 5, 7]], [12, 4, [1, 3, 5]]];
const POLY_B: [number, number, number][] = [[2, 3, 5], [5, 1, 4], [6, 2, 3], [8, 1, 4], [9, 1, 5], [10, 2, 6], [12, 4, 4]];
const POLY_C: [number, number, number][] = [[4, 2, 2], [6, 1, 0], [7, 1, 1], [8, 2, 2], [10, 2, 3], [12, 2, 1], [14, 2, 0]];

const PW = 166;
const panelX = (i: number) => 8 + i * PW;
const X0 = 14, X1 = 150, Y0 = 62, Y1 = 176;
const tx = (px: number, t: number) => r(px + X0 + (t / 16) * (X1 - X0));
const py = (p: number) => r(Y1 - (p / 14) * (Y1 - Y0));
const segs = (px: number, notes: [number, number, number][]) => notes.map(([t, d, p]) => ({ x1: tx(px, t) + 1, x2: tx(px, t + d) - 1, y: py(p) }));

const panels = [
  { title: 'Monophony', sub: ['one line', '(chant, a solo folk song)'] },
  { title: 'Heterophony', sub: ['one tune, varied at once', '(gamelan, an Irish session)'] },
  { title: 'Homophony', sub: ['a tune plus chords', '(a hymn, most pop)'] },
  { title: 'Polyphony', sub: ['independent lines', '(a fugue, New Orleans jazz)'] },
].map((p, i) => ({ ...p, x: panelX(i) }));
---

<Figure
  title="Four textures"
  caption="Each panel draws pitch (up) over time (across). <strong>Monophony</strong> is a single line. In <strong>heterophony</strong>, several performers play the same tune at once, each decorating it differently (blue: the plain tune; orange: a decorated version). In <strong>homophony</strong>, one line leads and the rest move together as chords underneath, in the same rhythm. In <strong>polyphony</strong>, each line has its own contour and rhythm, and entries and cadences are staggered. Real music mixes them, often within a single song."
>
  <svg viewBox="0 0 680 196" role="img" aria-label="Monophony, heterophony, homophony, and polyphony drawn as lines of pitch over time">
    {panels.map((p, i) => (
      <g>
        <text x={p.x + 82} y="18" text-anchor="middle" class="fig-t">{p.title}</text>
        {p.sub.map((line, k) => <text x={p.x + 82} y={34 + k * 14} text-anchor="middle" class="fig-s">{line}</text>)}
        <rect x={p.x + 6} y={Y0 - 6} width={152} height={Y1 - Y0 + 12} rx="6" class="fig-box" />
        {segs(p.x, i === 3 ? MEL.map(([t, d, pp]): [number, number, number] => [t + 0, d, pp + 1]) : MEL).map((s) => (
          <line x1={s.x1} x2={s.x2} y1={s.y} y2={s.y} class="fig-sa" stroke-width={i === 1 ? 6 : 4} stroke-linecap="round" />
        ))}
        {i === 1 && segs(p.x, DECOR).map((s) => <line x1={s.x1} x2={s.x2} y1={s.y} y2={s.y} class="fig-sb" stroke-width="2.5" stroke-linecap="round" />)}
        {i === 2 &&
          CHORDS.flatMap(([t, d, ps]) => ps.map((pp) => ({ x1: tx(p.x, t) + 1, x2: tx(p.x, t + d) - 1, y: py(pp) }))).map((s) => (
            <line x1={s.x1} x2={s.x2} y1={s.y} y2={s.y} class="fig-sb" stroke-width="5" stroke-linecap="round" stroke-opacity="0.55" />
          ))}
        {i === 3 && segs(p.x, POLY_B).map((s) => <line x1={s.x1} x2={s.x2} y1={s.y} y2={s.y} class="fig-sb" stroke-width="4" stroke-linecap="round" />)}
        {i === 3 && segs(p.x, POLY_C).map((s) => <line x1={s.x1} x2={s.x2} y1={s.y} y2={s.y} class="fig-sc" stroke-width="4" stroke-linecap="round" />)}
      </g>
    ))}
  </svg>
</Figure>
