---
// Three ways two patterns can disagree, drawn on one time axis each:
// polyrhythm (same span, different pulses: 3 against 2), polymeter (same
// pulse, different loop lengths: 3 against 4, realigning after 12 steps),
// and phasing (same pattern, one copy shifted: the 12-pulse bell pattern
// against itself, one pulse ahead). All positions are computed.
import Figure from '../ui/Figure.astro';

const r = (v: number) => Math.round(v * 10) / 10;
const X0 = 200, X1 = 664;
const span = X1 - X0;

// Band 1: 3 against 2 over two cycles
const P = { y: 42 };
const cyc = 2;
const polyA = Array.from({ length: 3 * cyc }, (_, k) => r(X0 + (k / (3 * cyc)) * span));
const polyB = Array.from({ length: 2 * cyc }, (_, k) => r(X0 + (k / (2 * cyc)) * span));
const cycLines = Array.from({ length: cyc + 1 }, (_, k) => r(X0 + (k / cyc) * span));

// Band 2: 3-step loop against 4-step loop, 12 steps, then the start of the next round
const M = { y: 148 };
const steps = 13;
const sw = span / steps;
const sx = (i: number) => r(X0 + (i + 0.5) * sw);
const meterA = Array.from({ length: steps }, (_, i) => ({ x: sx(i), start: i % 3 === 0 }));
const meterB = Array.from({ length: steps }, (_, i) => ({ x: sx(i), start: i % 4 === 0 }));

// Band 3: bell pattern against itself, one pulse ahead
const F = { y: 254 };
const bell = 'x.x.xx.x.x.x'.split('').map((c) => c === 'x');
const pw = span / 12;
const px = (i: number) => r(X0 + (i + 0.5) * pw);
const shift = 1;
const moved = bell.map((_, i) => bell[(i + shift) % 12]);
---

<Figure
  title="Three ways two patterns can disagree"
  caption="Top: a polyrhythm. Two pulses divide the same span into different numbers of equal parts (3 against 2) and meet at the start of every cycle. Middle: polymeter. Both parts step on the same pulse, but one loop is 3 steps long and the other 4, so their starts (larger marks) drift apart and coincide again only every 12 steps. Bottom: phasing. One pattern against an identical copy that has moved one pulse ahead; every offset gives a different combined rhythm."
>
  <svg viewBox="0 0 680 318" role="img" aria-label="Polyrhythm, polymeter, and phasing compared on three timelines">
    {/* labels */}
    <text x="16" y={P.y - 8} class="fig-t">Polyrhythm</text>
    <text x="16" y={P.y + 8} class="fig-s">same span,</text>
    <text x="16" y={P.y + 22} class="fig-s">different pulses</text>
    <text x="16" y={M.y - 8} class="fig-t">Polymeter</text>
    <text x="16" y={M.y + 8} class="fig-s">same pulse,</text>
    <text x="16" y={M.y + 22} class="fig-s">different loop lengths</text>
    <text x="16" y={F.y - 8} class="fig-t">Phasing</text>
    <text x="16" y={F.y + 8} class="fig-s">same pattern,</text>
    <text x="16" y={F.y + 22} class="fig-s">one copy shifted</text>

    {/* band 1 */}
    {cycLines.map((x) => <line x1={x} x2={x} y1={P.y - 22} y2={P.y + 44} class="fig-thin" stroke-dasharray="3 3" />)}
    <text x={X0 + span / 4} y={P.y - 26} text-anchor="middle" class="fig-s">one cycle</text>
    <text x={X0 + (3 * span) / 4} y={P.y - 26} text-anchor="middle" class="fig-s">next cycle</text>
    <line x1={X0} x2={X1} y1={P.y} y2={P.y} class="fig-thin" />
    <line x1={X0} x2={X1} y1={P.y + 24} y2={P.y + 24} class="fig-thin" />
    {polyA.map((x) => <circle cx={x} cy={P.y} r="7" class="fig-a" />)}
    {polyB.map((x) => <rect x={x - 7} y={P.y + 17} width="14" height="14" rx="2" class="fig-b" />)}
    <text x={X1 + 6} y={P.y + 4} class="fig-s">3</text>
    <text x={X1 + 6} y={P.y + 28} class="fig-s">2</text>

    {/* band 2 */}
    {meterA.map((s, i) => <line x1={r(X0 + i * sw)} x2={r(X0 + i * sw)} y1={M.y - 14} y2={M.y + 38} class="fig-grid" />)}
    {meterA.map((s) => (s.start ? <circle cx={s.x} cy={M.y} r="7" class="fig-a" /> : <circle cx={s.x} cy={M.y} r="3.5" class="fig-a" />))}
    {meterB.map((s) => (s.start ? <rect x={s.x - 7} y={M.y + 17} width="14" height="14" rx="2" class="fig-b" /> : <rect x={s.x - 3.5} y={M.y + 20.5} width="7" height="7" rx="1" class="fig-b" />))}
    <line x1={r(X0 + 12 * sw)} x2={r(X0 + 12 * sw)} y1={M.y - 26} y2={M.y + 46} class="fig-line" />
    <text x={r(X0 + 12 * sw) - 4} y={M.y - 30} text-anchor="end" class="fig-s">together again after 12 steps</text>
    <line x1={X0} x2={X0} y1={M.y - 26} y2={M.y + 46} class="fig-line" />
    <text x={X1 + 6} y={M.y + 4} class="fig-s">3</text>
    <text x={X1 + 6} y={M.y + 28} class="fig-s">4</text>

    {/* band 3 */}
    {bell.map((_, i) => <line x1={r(X0 + i * pw)} x2={r(X0 + i * pw)} y1={F.y - 14} y2={F.y + 38} class="fig-grid" />)}
    <line x1={X1} x2={X1} y1={F.y - 14} y2={F.y + 38} class="fig-grid" />
    {bell.map((on, i) => (on ? <circle cx={px(i)} cy={F.y} r="7" class="fig-a" /> : <circle cx={px(i)} cy={F.y} r="2" class="fig-head" />))}
    {moved.map((on, i) => (on ? <rect x={px(i) - 7} y={F.y + 17} width="14" height="14" rx="2" class="fig-b" /> : <circle cx={px(i)} cy={F.y + 24} r="2" class="fig-head" />))}
    <text x={X0} y={F.y + 56} class="fig-s">lower copy: the same strokes, each arriving one pulse earlier</text>
  </svg>
</Figure>
