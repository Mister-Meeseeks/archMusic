---
// Equal-loudness contours, computed from the ISO 226:2003 formula
// (src/lib/loudness.ts). Each curve joins pure tones that sound equally loud;
// the dashed curve is the threshold of hearing. Annotated: at 63 Hz a quiet
// tone needs a big boost to match 1 kHz, a loud one much less.
import Figure from '../ui/Figure.astro';
import { ISO_F, ISO_TF, contour, splAt } from '../../lib/loudness';

const r = (v: number) => Math.round(v * 10) / 10;
const X0 = 62, X1 = 650, Y0 = 20, Y1 = 270;
const FMIN = 20, FMAX = 16000, DBMIN = -10, DBMAX = 130;
const fx = (f: number) => r(X0 + (Math.log(f / FMIN) / Math.log(FMAX / FMIN)) * (X1 - X0));
const dy = (d: number) => r(Y1 - ((d - DBMIN) / (DBMAX - DBMIN)) * (Y1 - Y0));
const path = (vals: number[]) => vals.map((v, i) => `${i ? 'L' : 'M'}${fx(ISO_F[i])},${dy(v)}`).join(' ');

const PHONS = [20, 40, 60, 80];
const curves = PHONS.map((p) => ({ p, d: path(contour(p)), end: contour(p)[ISO_F.length - 1] }));
const threshold = path(ISO_TF);
const xticks = [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000];
const yticks = [0, 20, 40, 60, 80, 100, 120];
const lab = (f: number) => (f >= 1000 ? `${f / 1000}k` : String(f));

// annotation at 63 Hz
const F = 63;
const q = splAt(F, 40), l = splAt(F, 80);
---

<Figure
  title="Equal-loudness contours"
  caption="Each solid curve joins pure tones that sound equally loud to an average young listener. Every point on the “40” curve sounds as loud as a 1,000 Hz tone at 40 dB; that loudness level is called 40 <em>phons</em>. The dashed curve is the quietest tone that can be heard at all. The ear is most sensitive around 2–5 kHz and much less sensitive in the bass. At 63 Hz, a quiet tone needs about 33 dB more sound pressure than at 1 kHz to sound equally loud, while a loud one needs only about 18 dB more: the curves flatten as the level rises. Computed from the ISO 226:2003 formula."
>
  <svg viewBox="0 0 680 310" role="img" aria-label="Equal-loudness contours from 20 to 80 phons, plus the threshold of hearing, from 20 Hz to 12.5 kHz">
    <defs>
      <marker id="el-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" class="fig-head" />
      </marker>
    </defs>
    {xticks.map((f) => (
      <g>
        <line x1={fx(f)} x2={fx(f)} y1={Y0} y2={Y1} class="fig-grid" />
        <text x={fx(f)} y={Y1 + 16} text-anchor="middle" class="fig-s">{lab(f)}</text>
      </g>
    ))}
    {yticks.map((d) => (
      <g>
        <line x1={X0} x2={X1} y1={dy(d)} y2={dy(d)} class="fig-grid" />
        <text x={X0 - 8} y={dy(d) + 4} text-anchor="end" class="fig-s">{d}</text>
      </g>
    ))}
    <text x={(X0 + X1) / 2} y={Y1 + 34} text-anchor="middle" class="fig-s">frequency (Hz, log scale)</text>
    <text x={16} y={(Y0 + Y1) / 2} text-anchor="middle" class="fig-s" transform={`rotate(-90 16 ${(Y0 + Y1) / 2})`}>sound pressure level (dB SPL)</text>

    <path d={threshold} class="fig-thin" stroke-dasharray="5 4" />
    <text x={fx(5000)} y={dy(-8)} class="fig-s">threshold of hearing</text>
    {curves.map((c) => (
      <g>
        <path d={c.d} class="fig-sa" />
        <text x={fx(12500) + 6} y={dy(c.end) + 4} class="fig-t">{c.p}</text>
      </g>
    ))}
    <text x={fx(12500) + 4} y={dy(curves[3].end) - 16} class="fig-s">phons</text>

    {/* 1 kHz: phons equal dB */}
    {PHONS.map((p) => <circle cx={fx(1000)} cy={dy(p)} r="3.5" class="fig-b" />)}
    <text x={fx(1000) + 6} y={dy(100)} class="fig-s">at 1 kHz, phons = dB</text>
    <line x1={fx(1000) + 18} y1={dy(97)} x2={fx(1000) + 3} y2={dy(83)} class="fig-thin" marker-end="url(#el-arrow)" />

    {/* 63 Hz boosts */}
    <line x1={fx(F)} x2={fx(F)} y1={dy(40)} y2={dy(q) + 4} class="fig-line" marker-end="url(#el-arrow)" />
    <line x1={fx(F) + 10} x2={fx(F) + 10} y1={dy(80)} y2={dy(l) + 4} class="fig-line" marker-end="url(#el-arrow)" />
    <line x1={fx(F) - 6} x2={fx(1000)} y1={dy(40)} y2={dy(40)} class="fig-thin" stroke-dasharray="2 3" />
    <line x1={fx(F) + 4} x2={fx(1000)} y1={dy(80)} y2={dy(80)} class="fig-thin" stroke-dasharray="2 3" />
    <text x={fx(F) - 8} y={dy((40 + q) / 2) + 4} text-anchor="end" class="fig-t fig-halo">+{Math.round(q - 40)} dB</text>
    <text x={fx(F) + 16} y={dy((80 + l) / 2) + 4} class="fig-t fig-halo">+{Math.round(l - 80)} dB</text>
  </svg>
</Figure>
