---
// The seven diatonic modes ordered from brightest to darkest. Each row places
// the mode's degrees on a grid of semitones above home; orange degrees differ
// from the major scale. Going down one row lowers exactly one note by a
// semitone (ringed). Positions come straight from MODES in lib/tonality.
import Figure from '../ui/Figure.astro';
import { MODES } from '../../lib/tonality';

const MAJOR = [0, 2, 4, 5, 7, 9, 11];
const GX0 = 178, GX1 = 498, Y0 = 62, ROW = 36;
const sx = (s: number) => Math.round((GX0 + (s / 12) * (GX1 - GX0)) * 10) / 10;
const rows = MODES.map((m, i) => {
  const prev = i > 0 ? MODES[i - 1].semis : null;
  const dots = [...m.semis, 12].map((s, d) => {
    const deg = d % 7;
    const diff = s % 12 === 0 && d === 7 ? 0 : s - MAJOR[deg];
    const label = (diff < 0 ? '♭' : diff > 0 ? '♯' : '') + String(deg + 1);
    const moved = prev != null && d < 7 && prev[d] !== s;
    return { x: sx(s), label, altered: diff !== 0, moved, from: moved && prev ? sx(prev[d]) : 0 };
  });
  const steps = m.semis.map((s, k) => (k < 6 ? m.semis[k + 1] - s : 12 - s));
  return { name: m.name.replace(/ \(.*\)/, ''), sub: m.id === 'ionian' ? 'major' : m.id === 'aeolian' ? 'natural minor' : '', white: m.white, y: Y0 + i * ROW, dots, steps };
});
---

<Figure
  title="The modes from brightest to darkest"
  caption="Each row is one mode, with its degrees placed by how many semitones they sit above home (0 is home, 12 is home an octave up). Orange degrees differ from the major scale. Read down: every row lowers exactly one note by a semitone (the ringed dot; the faint line shows where it came from), so the modes form a ladder from bright Lydian to dark Locrian. The right columns give each mode's step pattern in semitones, and which white keys form the mode when it uses only white keys."
>
  <svg viewBox="0 0 680 300" role="img" aria-label="The seven modes placed on a semitone grid, ordered from brightest to darkest">
    <text x="20" y="22" class="fig-h">Mode</text>
    <text x={GX0} y="22" class="fig-h">Semitones above home</text>
    <text x="528" y="22" class="fig-h">Steps</text>
    <text x="672" y="22" text-anchor="end" class="fig-h">White keys</text>
    {Array.from({ length: 13 }, (_, s) => (
      <g>
        <line x1={sx(s)} x2={sx(s)} y1="38" y2={Y0 + 6 * ROW + 14} class="fig-grid" />
        <text x={sx(s)} y="34" text-anchor="middle" class="fig-s">{s}</text>
      </g>
    ))}
    {rows.map((r) => (
      <g>
        <text x="20" y={r.y + (r.sub ? -1 : 4)} class="fig-t">{r.name}</text>
        {r.sub && <text x="20" y={r.y + 12} class="fig-s">{r.sub}</text>}
        <line x1={r.dots[0].x} x2={r.dots[7].x} y1={r.y} y2={r.y} class="fig-thin" />
        {r.dots.map((d) => (
          <g>
            {d.moved && <line x1={d.from} x2={d.x + 11} y1={r.y - 13} y2={r.y - 13} class="fig-thin" stroke-dasharray="2 3" />}
            <circle cx={d.x} cy={r.y} r="11" class={d.altered ? 'mode-dot is-alt' : 'mode-dot'} />
            {d.moved && <circle cx={d.x} cy={r.y} r="14.5" class="mode-ring" />}
            <text x={d.x} y={r.y + 4} text-anchor="middle" class={d.altered ? 'mode-deg is-alt' : 'mode-deg'}>{d.label}</text>
          </g>
        ))}
        <text x="528" y={r.y + 4} class="fig-s mode-steps">{r.steps.join(' ')}</text>
        <text x="672" y={r.y + 4} text-anchor="end" class="fig-t">{r.white}–{r.white}</text>
      </g>
    ))}
  </svg>
</Figure>
