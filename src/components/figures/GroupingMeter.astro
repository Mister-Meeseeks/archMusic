---
// Grouping and meter are separate structures (Lerdahl & Jackendoff 1983).
// "Happy Birthday" (public domain): each phrase starts on a pickup, the last
// beat of the bar before, so the phrase brackets above never line up with the
// bar lines below. Positions are in eighth notes; 3/4, so a beat is 2 and a
// bar is 6. The metrical dots are computed from those numbers.
import Figure from '../ui/Figure.astro';

const r = (v: number) => Math.round(v * 10) / 10;
// [midi, start, duration] in eighth notes; time 0 = first downbeat
const notes: [number, number, number, string][] = [
  [55, -2, 1.5, 'Hap'], [55, -0.5, 0.5, 'py'], [57, 0, 2, 'birth'], [55, 2, 2, 'day'], [60, 4, 2, 'to'], [59, 6, 4, 'you,'],
  [55, 10, 1.5, 'hap'], [55, 11.5, 0.5, 'py'], [57, 12, 2, 'birth'], [55, 14, 2, 'day'], [62, 16, 2, 'to'], [60, 18, 4, 'you'],
];
const T0 = -2.6, T1 = 24;
const X0 = 70, X1 = 664;
const tx = (t: number) => r(X0 + ((t - T0) / (T1 - T0)) * (X1 - X0));
const py = (m: number) => r(150 - (m - 55) * 7);
const phrases = [
  { a: -2, b: 10, label: 'phrase 1' },
  { a: 10, b: 22, label: 'phrase 2' },
];
const bars = [0, 6, 12, 18, 24];
// metrical grid: eighths (level 1), beats (2), downbeats (3)
const dots = Array.from({ length: 26 }, (_, k) => k - 2).map((t) => ({ t, lvl: 1 + (t % 2 === 0 ? 1 : 0) + (((t % 6) + 6) % 6 === 0 ? 1 : 0) }));
---

<Figure
  title="Grouping is not meter"
  caption="The first two phrases of “Happy Birthday,” in 3/4. Above: the grouping, which notes belong together as a phrase. Below: the meter, drawn as a grid of dots (more dots, stronger position) with bar lines. The two don't line up. Each phrase starts on a pickup (orange), the last beat of the previous bar, and ends in the middle of a bar. Phrase 2 begins where bar 2 is only two-thirds over. You hear both structures at once: the groups tell you where the words and ideas go, the meter tells you where the strong beats are."
>
  <svg viewBox="0 0 680 250" role="img" aria-label="Happy Birthday's phrases drawn as brackets above, its 3/4 metrical grid as dots below; the brackets start before the bar lines">
    <text x="10" y="36" class="fig-h">Grouping</text>
    {phrases.map((p) => (
      <g>
        <path d={`M${tx(p.a) + 2},50 L${tx(p.a) + 2},40 L${tx(p.b) - 4},40 L${tx(p.b) - 4},50`} class="fig-line" />
        <text x={(tx(p.a) + tx(p.b)) / 2} y="32" text-anchor="middle" class="fig-s">{p.label}</text>
      </g>
    ))}

    {bars.map((b) => (
      <line x1={tx(b)} x2={tx(b)} y1="62" y2="226" class="fig-thin" />
    ))}
    {notes.map(([m, t, d, syl]) => (
      <g>
        <rect x={tx(t) + 1} y={py(m) - 5} width={r(tx(t + d) - tx(t) - 3)} height="10" rx="4" class={t === -2 || t === 10 || t === -0.5 || t === 11.5 ? 'fig-b' : 'fig-a'} />
        <text x={r((tx(t) + tx(t + d)) / 2)} y="168" text-anchor="middle" class="fig-s">{syl}</text>
      </g>
    ))}

    <text x="10" y="196" class="fig-h">Meter</text>
    {dots.map((d) =>
      Array.from({ length: d.lvl }, (_, l) => <circle cx={tx(d.t)} cy={186 + l * 10} r="2.6" class="fig-head" />),
    )}
    {bars.slice(0, 4).map((b, i) => (
      <text x={tx(b) + 4} y="240" class="fig-s">bar {i + 1}</text>
    ))}
    <path d={`M${tx(-2)},74 L${tx(0) - 3},74`} class="fig-line" stroke-dasharray="3 3" />
    <text x={tx(-2)} y="86" class="fig-s">pickup</text>
  </svg>
</Figure>
