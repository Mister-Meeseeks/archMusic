---
// How well each equal division of the octave (5 to 53 steps) approximates a
// pure fifth (3:2) and a pure major third (5:4). Computed: for each N, the
// nearest step to the pure interval and its error in cents. Errors above
// 40 cents are drawn as hollow dots at the top edge.
import Figure from '../ui/Figure.astro';

const r = (v: number) => Math.round(v * 10) / 10;
const cents = (x: number) => 1200 * Math.log2(x);
const err = (n: number, ratio: number) => {
  const c = cents(ratio);
  return (Math.round((c / 1200) * n) * 1200) / n - c;
};
const N0 = 5, N1 = 53, X0 = 64, X1 = 664, Y0 = 46, Y1 = 236, MAX = 40;
const x = (n: number) => r(X0 + ((n - N0) / (N1 - N0)) * (X1 - X0));
const y = (e: number) => r(Y1 - (Math.min(Math.abs(e), MAX) / MAX) * (Y1 - Y0));
const ns = Array.from({ length: N1 - N0 + 1 }, (_, i) => N0 + i);
const pts = ns.map((n) => ({ n, f: err(n, 3 / 2), t: err(n, 5 / 4) }));
const marked = [12, 19, 22, 31, 34, 41, 53];
---

<Figure
  title="Why 12, and what else works"
  caption="For every way of dividing the octave into equal steps from 5 to 53, how far the nearest step is from a pure fifth (blue) and a pure major third (orange), in cents. Lower is better; the shaded band (under 5¢) is close to pure for most listeners. Twelve is the first division with an excellent fifth, which is why it won, but its thirds are 14¢ off. Nineteen and 31 trade a slightly worse fifth for much better thirds; 53 gets both almost exactly. Errors over 40¢ are drawn as hollow dots along the top."
>
  <svg viewBox="0 0 680 280" role="img" aria-label="Chart of fifth and major-third errors for equal divisions of the octave from 5 to 53 steps">
    <rect x={X0} y={y(5)} width={X1 - X0} height={r(Y1 - y(5))} class="fig-band" />
    {[0, 10, 20, 30, 40].map((e) => (
      <g>
        <line x1={X0} x2={X1} y1={y(e)} y2={y(e)} class="fig-grid" />
        <text x={X0 - 8} y={y(e) + 4} text-anchor="end" class="fig-s">{e === 40 ? '40+' : e}¢</text>
      </g>
    ))}
    {marked.map((n) => (
      <g>
        <line x1={x(n)} x2={x(n)} y1={Y0 - 6} y2={Y1} class="fig-thin" stroke-dasharray="2 3" />
        <text x={x(n)} y={Y1 + 18} text-anchor="middle" class="fig-t">{n}</text>
      </g>
    ))}
    {ns.filter((n) => n % 5 === 0 && !marked.some((m) => Math.abs(m - n) <= 2)).map((n) => (
      <text x={x(n)} y={Y1 + 18} text-anchor="middle" class="fig-s">{n}</text>
    ))}
    <text x={(X0 + X1) / 2} y={Y1 + 38} text-anchor="middle" class="fig-s">equal steps per octave</text>
    {pts.map((p) => (
      <g>
        <circle cx={x(p.n)} cy={y(p.t)} r="3.6" class={Math.abs(p.t) > MAX ? 'fig-hollow-b' : 'fig-b'} />
        <circle cx={x(p.n)} cy={y(p.f)} r="3.6" class={Math.abs(p.f) > MAX ? 'fig-hollow-a' : 'fig-a'} />
      </g>
    ))}
    <circle cx={X0 + 8} cy="18" r="4" class="fig-a" />
    <text x={X0 + 18} y="22" class="fig-s">fifth (3:2)</text>
    <circle cx={X0 + 110} cy="18" r="4" class="fig-b" />
    <text x={X0 + 120} y="22" class="fig-s">major third (5:4)</text>
    <text x={X1} y="22" text-anchor="end" class="fig-s">error of the nearest step</text>
  </svg>
</Figure>
